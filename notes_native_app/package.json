{
  "name": "notes_native_app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --clear",
    "start:ci": "expo start --non-interactive --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:web": "expo start --web --non-interactive",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@types/react-native": "~0.76.0",
    "typescript": "~5.6.3",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-native|react-native|react-native-gesture-handler|react-native-reanimated|react-native-screens|@react-navigation)/)"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
